{
  "name": "sillytavern-card-manager",
  "version": "2.2.13",
  "description": "SillyTavern 角色卡高级解析中心 - 本地桌面版（Vue 3 + Tailwind CSS + Electron）",
  "main": "main.js",
  "author": {
    "name": "SillyTavern Community"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "start:dev": "set VITE_DEV_SERVER_URL=http://localhost:5173&& electron .",
    "build:web": "if exist web rmdir /s /q web & vite build",
    "start": "npm run build:web && electron .",
    "build": "npm run build:web && electron-builder -w",
    "test": "node --test \"test/**/*.test.mjs\"",
    "guard:batch-read": "node scripts/check-batch-read-guard.mjs",
    "guard:scope": "node scripts/check-undefined-scope.mjs",
    "guard:dedupe": "node scripts/check-dedupe-api.mjs && node scripts/check-dedupe-literals.mjs",
    "check": "npm run guard:batch-read && npm run guard:scope && npm run guard:dedupe && npm test"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.4",
    "echarts": "^6.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "handlebars": "^4.7.9",
    "postcss": "^8.5.26",
    "showdown": "^2.1.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.5.41"
  },
  "build": {
    "appId": "com.sillytavern.cardmanager",
    "productName": "SillyTavern 角色卡管理器",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tian2418671-sys",
        "repo": "JSKZX"
      }
    ],
    "files": [
      "web/**/*",
      "main.js",
      "main/**/*",
      "js/utils/simhash64.mjs",
      "preload.js",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@xenova/transformers/**",
      "node_modules/onnxruntime-node/**"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false,
      "icon": "icon.ico",
      "artifactName": "${name}-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@xenova/transformers": "^2.17.2",
    "codemirror": "^6.0.2",
    "dompurify": "3.4.13",
    "electron-updater": "6.8.9",
    "jquery": "^3.7.1",
    "js-beautify": "^2.0.3",
    "sharp": "0.35.3"
  }
}
